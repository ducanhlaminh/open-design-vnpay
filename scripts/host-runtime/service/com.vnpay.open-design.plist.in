<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Open Design host runtime — macOS LaunchAgent template.

  Placeholders substituted by deploy/host/install.sh at install time:
    @OD_BIN@   absolute path to the `node` executable to run (system Node if
               it satisfies apps/daemon/package.json#engines, otherwise the
               private Node install.sh downloaded under @OD_HOME@/tools/node).
    @OD_HOME@  absolute path to the install home (~/.open-design by default).

  launchd has no native "EnvironmentFile=" directive (unlike systemd), so this
  wraps the daemon in a login-shell-free `/bin/sh -c` that sources
  @OD_HOME@/config.env before exec'ing node — the daemon reads config.env's
  OD_* / MEDIA_* / IDENTITY_URL entries from its own process.env.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vnpay.open-design</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; [ -f "@OD_HOME@/config.env" ] &amp;&amp; . "@OD_HOME@/config.env"; set +a; exec "@OD_BIN@" "@OD_HOME@/current/apps/daemon/dist/cli.js" --no-open</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@OD_HOME@/current</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!--
    Interactive, NOT Background. `Background` puts the job in macOS's throttled
    tier (PRIO_DARWIN_BG): lowest CPU priority, throttled disk I/O, background
    socket traffic class -- and every child it spawns (the agent CLI, docker,
    build scripts) inherits it. A user sitting in the web UI is waiting on this
    process for EVERY request, so that tier is exactly wrong here.

    Measured on 0.8.69 (same binary, only this key differing):
      idle   GET /api/skills   0.12 s  (Background)  vs  0.04 s (Interactive)
      loaded GET /api/skills   0.50 s               vs  0.07 s
      loaded GET /api/agents   9.1 s                vs  0.3-0.7 s
    Reported from the field as "cài trên Mac Intel chạy rất chậm" -- weaker
    single-core machines under real desktop load are starved hardest.

    The Linux systemd unit deliberately carries no Nice=/IO limits either.
  -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>@OD_HOME@/logs/open-design.out.log</string>

  <key>StandardErrorPath</key>
  <string>@OD_HOME@/logs/open-design.err.log</string>
</dict>
</plist>
