{
  "servers": [
    {
      "id": "kg-local",
      "transport": "stdio",
      "enabled": true,
      "label": "Local UI Knowledge Graph (od-kg)",
      "command": "node",
      "args": [
        "<repo>/tools/kg/bin/tools-kg.mjs",
        "mcp"
      ],
      "env": {
        "OD_KG_BOLT_URI": "bolt://localhost:27787",
        "OD_KG_USER": "neo4j",
        "OD_KG_PASSWORD": "od_local_password",
        "OD_KG_WORKSPACE": "ws-od-prototypes"
      }
    },
    {
      "id": "ba-agent",
      "transport": "http",
      "enabled": true,
      "label": "BA Agent",
      "url": "https://a2.openledger.vn/api/mcp/",
      "authMode": "none",
      "headers": {
        "Authorization": "Bearer <BAS_MCP_TOKEN>"
      }
    },
    {
      "id": "mcp-atlassian",
      "transport": "stdio",
      "enabled": true,
      "label": "Atlassian (Jira + Confluence Data Center)",
      "command": "uvx",
      "args": [
        "mcp-atlassian@0.21.1"
      ],
      "env": {
        "JIRA_URL": "https://jr.servicehub.vn",
        "JIRA_PERSONAL_TOKEN": "<JIRA_PERSONAL_TOKEN>",
        "CONFLUENCE_URL": "https://wiki.servicehub.vn",
        "CONFLUENCE_PERSONAL_TOKEN": "<CONFLUENCE_PERSONAL_TOKEN>"
      }
    }
  ]
}
